{
  "name": "feriazone",
  "version": "1.0.0",
  "description": "Mercado online y guía de ferias de Río Cuarto - EFI Programación II 2026",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:css": "tailwindcss -i ./css/input.css -o ./css/styles.css --watch",
    "dev:server": "live-server --port=3000 --mount=/:. --no-browser --quiet",
    "dev": "concurrently \"npm run dev:css\" \"npm run dev:server\"",
    "build": "tailwindcss -i ./css/input.css -o ./css/styles.css --minify"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "live-server": "^1.2.2",
    "tailwindcss": "^3.4.17"
  }
}
